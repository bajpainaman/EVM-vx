#!/usr/bin/env bash
# Runs the Vx compiler with this repository's src/ on the module path.
# The compiler must be the Vx v0.0.5 release. The sources use raw-pointer field
# reads that the earlier dc6a460 build rejects.
set -eu
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export VX_EXTRA_PATH="$ROOT/src${VX_EXTRA_PATH:+:$VX_EXTRA_PATH}"
exec "${VXC:-/data/fast/vx-toolchain/vxc}" "$@"
