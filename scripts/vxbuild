#!/usr/bin/env bash
# Compiles one Vx entry file to a native object with `vxc -a emit-obj`, which
# targets the host. Since Vx v0.0.5 the object leaves `extern` symbols
# undefined, so Vx code can call host functions that are linked in later.
#
# Usage: scripts/vxbuild <entry.vx> <out.o> [opt-level 0|1|2|3]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$1"; OUT="$2"; OPT="${3:-2}"
LLVM="${LLVM_BIN:-/usr/lib/llvm-22/bin}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
# vxc runs mlir-translate and llc from PATH.
if ! PATH="$LLVM:$PATH" VX_LLVM_BIN="$LLVM" "$ROOT/scripts/vxc" -a emit-obj "$SRC" "-O$OPT" -o "$OUT" > "$TMP/log" 2>&1; then
  grep -vE '^\[JIT\]|W1007|i32::from' "$TMP/log" >&2 || true
  exit 1
fi
