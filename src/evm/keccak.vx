// XORs 136 bytes (17 little-endian lanes) at p into the state.
fn keccak_absorb(st: *mut u64, p: *mut u8) -> void {
  let mut i: u64 = 0u64;
  while i < 17u64 {
    let mut v: u64 = 0u64;
    let mut j: u64 = 0u64;
    while j < 8u64 {
      let b: u8 = unsafe { p[i * 8u64 + j] };
      v = v | ((b as u64) << (j * 8u64));
      j = j + 1u64;
    }
    let old: u64 = unsafe { st[i] };
    unsafe { st[i] = old ^ v; }
    i = i + 1u64;
  }
}

fn bswap64(x: u64) -> u64 {
  let mut r: u64 = 0u64;
  let mut i: u64 = 0u64;
  while i < 8u64 {
    r = (r << 8u64) | ((x >> (i * 8u64)) & 255u64);
    i = i + 1u64;
  }
  return r;
}

// Keccak-256 of n bytes at p, as a big-endian word (hash byte 0 is the top byte).
fn keccak256(p: *mut u8, n: u64) -> U256 {
