// Owner-confined prefix state for YOLO execution. Workers read a separate,
// immutable empty instance over StateDb. Only the finalizer writes this store,
// in transaction order, so a location needs one final value, not a version list.
struct MvEntry {
  txi: u64,
  incarnation: u64,
  balance: U256,
  val: U256,
  nonce: u64,
  code_hash: U256,
  code: *mut u8,
  code_len: u64,
  flags: u64,
}

const MV_DELETED: u64 = 2u64;
const MV_ACCOUNT: u64 = 4u64;
const MV_RESET: u64 = 8u64;

struct MvMem {
  db: *mut StateDb,
  amap: *mut Map,
  smap: *mut Map,
  // Address -> writer + 1 of the last storage wipe.
  resets: *mut Map,
  entries: *mut MvEntry,
  n: u64,
  cap: u64,
}

fn mv_new(db: *mut StateDb, cap_hint: u64) -> *mut MvMem {
  let raw: *mut i8 = unsafe { vx_calloc(1u64, sizeof<MvMem>() as u64) };
  let m: *mut MvMem = raw;
  let mm: &mut MvMem = unsafe { &mut m[0u64] };
  mm.db = db;
  mm.amap = map_new();
  mm.smap = map_new();
  mm.resets = map_new();
  let mut cap: u64 = cap_hint;
  if cap < 16u64 {
    cap = 16u64;
  }
  mm.cap = cap;
  let ep: *mut i8 = unsafe { vx_calloc(cap, sizeof<MvEntry>() as u64) };
  mm.entries = ep;
  return m;
}

const MVR_HIT: u64 = 0u64;
const MVR_BASE: u64 = 2u64;

// All installed writers precede the transaction being finalized. There is no
// concurrent writer, table replacement, incarnation search, or entry lock.
fn mv_read(m: *mut MvMem, is_acct: bool, a: U256, k: U256, txi: u64, out: *mut MvEntry) -> u64 {
  let mm: &mut MvMem = unsafe { &mut m[0u64] };
  let mut map: *mut Map = mm.smap;
  if is_acct {
    map = mm.amap;
  }
  let li: u64 = map_get(map, a, k);
  let mut reset: u64 = MAP_NONE;
  if !is_acct {
    reset = map_get(mm.resets, a, u256_zero());
  }
  if li != MAP_NONE {
    let e: &mut MvEntry = unsafe { &mut (mm.entries)[li] };
    if reset == MAP_NONE || e.txi + 1u64 >= reset {
      unsafe { out[0u64] = mm.entries[li]; }
      return MVR_HIT;
    }
  }
  if reset != MAP_NONE {
    unsafe {
      out[0u64] = MvEntry { txi: reset - 1u64, incarnation: 0u64,
        balance: u256_zero(), val: u256_zero(), nonce: 0u64,
        code_hash: u256_zero(), code: null_u8(), code_len: 0u64, flags: MV_RESET };
    }
    return MVR_HIT;
  }
  return MVR_BASE;
}

fn mv_write(m: *mut MvMem, is_acct: bool, a: U256, k: U256, e: *mut MvEntry) -> u64 {
  let mm: &mut MvMem = unsafe { &mut m[0u64] };
  let mut map: *mut Map = mm.smap;
  if is_acct {
    map = mm.amap;
  }
  let mut li: u64 = map_get(map, a, k);
  if li == MAP_NONE {
    if mm.n == mm.cap {
      mm.cap = mm.cap * 2u64;
      let old: *mut i8 = mm.entries;
      let ep: *mut i8 = unsafe {
        vx_realloc(old, mm.cap * (sizeof<MvEntry>() as u64))
      };
      mm.entries = ep;
    }
    li = mm.n;
    mm.n = li + 1u64;
    map_put(map, a, k, li);
  }
  unsafe { mm.entries[li] = e[0u64]; }
  let ent: &mut MvEntry = unsafe { &mut e[0u64] };
  if is_acct && (ent.flags & MV_RESET) != 0u64 {
    map_put(mm.resets, a, u256_zero(), ent.txi + 1u64);
  }
  return li;
}

fn mv_free(m: *mut MvMem) -> void {
  let mm: &mut MvMem = unsafe { &mut m[0u64] };
  map_free(mm.amap);
  map_free(mm.smap);
  map_free(mm.resets);
  let ep: *mut i8 = mm.entries;
  let raw: *mut i8 = m;
  unsafe { vx_free(ep); vx_free(raw); }
}
