  b = b + t1_58;
  f = t1_58 + t2_58;
  w11 = w11 + (((w12 >> 7u32) | (w12 << 25u32)) ^ ((w12 >> 18u32) | (w12 << 14u32)) ^ (w12 >> 3u32)) + w4 + (((w9 >> 17u32) | (w9 << 15u32)) ^ ((w9 >> 19u32) | (w9 << 13u32)) ^ (w9 >> 10u32));
  let t1_59: u32 = e + (((b >> 6u32) | (b << 26u32)) ^ ((b >> 11u32) | (b << 21u32)) ^ ((b >> 25u32) | (b << 7u32))) + (d ^ (b & (c ^ d))) + 2361852424u32 + w11;
  let t2_59: u32 = (((f >> 2u32) | (f << 30u32)) ^ ((f >> 13u32) | (f << 19u32)) ^ ((f >> 22u32) | (f << 10u32))) + ((f & g) | (h & (f | g)));
  a = a + t1_59;
  e = t1_59 + t2_59;
  w12 = w12 + (((w13 >> 7u32) | (w13 << 25u32)) ^ ((w13 >> 18u32) | (w13 << 14u32)) ^ (w13 >> 3u32)) + w5 + (((w10 >> 17u32) | (w10 << 15u32)) ^ ((w10 >> 19u32) | (w10 << 13u32)) ^ (w10 >> 10u32));
  let t1_60: u32 = d + (((a >> 6u32) | (a << 26u32)) ^ ((a >> 11u32) | (a << 21u32)) ^ ((a >> 25u32) | (a << 7u32))) + (c ^ (a & (b ^ c))) + 2428436474u32 + w12;
  let t2_60: u32 = (((e >> 2u32) | (e << 30u32)) ^ ((e >> 13u32) | (e << 19u32)) ^ ((e >> 22u32) | (e << 10u32))) + ((e & f) | (g & (e | f)));
  h = h + t1_60;
