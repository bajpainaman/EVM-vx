}

// SHA-256 of n bytes at p, written as 32 bytes to out.
// sha256_block_hw (hash_hw_arm.vx or hash_hw_portable.vx, chosen by build-lib.sh)
// compresses on the CPU's SHA-256 instructions, or calls evmvx_sha256_blocks_vx.

// Compresses n blocks at p into the eight state words a..h at st.
fn evmvx_sha256_blocks_vx(st: *mut u32, p: *mut u8, n: u64) -> void {
  let mut s: ShaState = ShaState { a: unsafe { st[0u64] }, b: unsafe { st[1u64] }, c: unsafe { st[2u64] }, d: unsafe { st[3u64] },
                                   e: unsafe { st[4u64] }, f: unsafe { st[5u64] }, g: unsafe { st[6u64] }, h: unsafe { st[7u64] } };
  let mut i: u64 = 0u64;
  while i < n {
    s = sha256_block(s, offset_mut(p, (i * 64u64) as i64));
    i = i + 1u64;
  }
  unsafe {
    st[0u64] = s.a; st[1u64] = s.b; st[2u64] = s.c; st[3u64] = s.d;
    st[4u64] = s.e; st[5u64] = s.f; st[6u64] = s.g; st[7u64] = s.h;
  }
}

// SHA-256 of n bytes at p, written as 32 bytes to out.
fn sha256(p: *mut u8, n: u64, out: *mut u8) -> void {
  // One buffer: the eight state words, then two blocks for the padded tail.
  let raw: *mut i8 = unsafe { vx_calloc(160u64, 1u64) };
  let st: *mut u32 = raw;
  unsafe { st[0u64] = 1779033703u32; }
  unsafe { st[1u64] = 3144134277u32; }
  unsafe { st[2u64] = 1013904242u32; }
  unsafe { st[3u64] = 2773480762u32; }
  unsafe { st[4u64] = 1359893119u32; }
  unsafe { st[5u64] = 2600822924u32; }
  unsafe { st[6u64] = 528734635u32; }
  unsafe { st[7u64] = 1541459225u32; }
  let full: u64 = n / 64u64;
  let mut bi: u64 = 0u64;
  while bi < full {
    sha256_block_hw(st, offset_mut(p, (bi * 64u64) as i64));
    bi = bi + 1u64;
  }
  let off: u64 = full * 64u64;
  // Final blocks: the tail, 0x80, zeros, then the bit length as a big-endian u64.
  let last: *mut u8 = offset_mut(raw, 32i64);
  let rem: u64 = n - off;
  if rem > 0u64 {
    let tail: *mut u8 = offset_mut(p, off as i64);
    copy_bytes(last, tail, rem);
  }
  unsafe { last[rem] = 128u8; }
  let mut total: u64 = 64u64;
  if rem >= 56u64 { total = 128u64; }
  store_be64(last, total - 8u64, n * 8u64);
  sha256_block_hw(st, last);
  if total == 128u64 { sha256_block_hw(st, offset_mut(last, 64i64)); }
  let mut k: u64 = 0u64;
  while k < 8u64 {
    put_be32(out, k * 4u64, unsafe { st[k] });
    k = k + 1u64;
  }
  unsafe { vx_free(raw); }
}

// 0x02: 60 + 12 per word.
fn pc_sha256(input: *mut u8, len: u64, gas_limit: u64, out: *mut PcOut) -> void {
  let cost: u64 = 60u64 + 12u64 * words_of(len);
  if !pc_charge(out, cost, gas_limit) { return; }
  let o: *mut u8 = zalloc(32u64);
  sha256(input, len, o);
  pc_set(out, PC_OK, cost, o, 32u64);
}
