  let t1_58: u32 = f + (((c >> 6u32) | (c << 26u32)) ^ ((c >> 11u32) | (c << 21u32)) ^ ((c >> 25u32) | (c << 7u32))) + (e ^ (c & (d ^ e))) + 2227730452u32 + w10;
