  let t1_61: u32 = c + (((h >> 6u32) | (h << 26u32)) ^ ((h >> 11u32) | (h << 21u32)) ^ ((h >> 25u32) | (h << 7u32))) + (b ^ (h & (a ^ b))) + 2756734187u32 + w13;
