// EVM byte order: a 32-byte word in memory, code or calldata is big endian.

// Byte i (0..8) of a big-endian u64 read at p + off, or 0 past len.
fn byte_at(p: *mut u8, len: u64, off: u64) -> u64 {
  if off >= len { return 0u64; }
  let b: u8 = unsafe { p[off] };
  return b as u64;
}

// Eight bytes at p + off as a big-endian u64; bytes at or past len read as zero.
fn load_be64_padded(p: *mut u8, len: u64, off: u64) -> u64 {
  let mut r: u64 = 0u64;
  let mut i: u64 = 0u64;
  while i < 8u64 {
    r = (r << 8u64) | byte_at(p, len, off + i);
    i = i + 1u64;
  }
  return r;
}

// 32 bytes at src + off as a big-endian word, zero padded past len.
// off may be any value; offsets at or beyond len give zero bytes.
fn u256_load_padded(src: *mut u8, len: u64, off: u64) -> U256 {
  if off >= len { return u256_zero(); }
  return U256 { l0: load_be64_padded(src, len, off + 24u64),
                l1: load_be64_padded(src, len, off + 16u64),
                l2: load_be64_padded(src, len, off + 8u64),
                l3: load_be64_padded(src, len, off) };
}

fn u256_load_be(p: *mut u8) -> U256 { return u256_load_padded(p, 32u64, 0u64); }

fn store_be64(p: *mut u8, off: u64, v: u64) -> void {
  let mut i: u64 = 0u64;
  while i < 8u64 {
    let b: u8 = ((v >> ((7u64 - i) * 8u64)) & 255u64) as u8;
    unsafe { p[off + i] = b; }
    i = i + 1u64;
  }
}

fn u256_store_be(p: *mut u8, v: U256) -> void {
  store_be64(p, 0u64, v.l3);
  store_be64(p, 8u64, v.l2);
  store_be64(p, 16u64, v.l1);
  store_be64(p, 24u64, v.l0);
}

// n bytes (n <= 32) at p + off as a big-endian number; bytes past len read as zero.
// PUSHn at the end of code reads its missing immediate bytes as zero.
fn u256_load_be_n(p: *mut u8, len: u64, off: u64, n: u64) -> U256 {
  let mut r: U256 = u256_zero();
  let mut i: u64 = 0u64;
  while i < n {
    let b: u64 = byte_at(p, len, off + i);
    r = U256 { l0: (r.l0 << 8u64) | b, l1: (r.l1 << 8u64) | (r.l0 >> 56u64),
               l2: (r.l2 << 8u64) | (r.l1 >> 56u64), l3: (r.l3 << 8u64) | (r.l2 >> 56u64) };
    i = i + 1u64;
  }
  return r;
}

// The low 160 bits: an address.
fn u256_to_address(v: U256) -> U256 {
  return U256 { l0: v.l0, l1: v.l1, l2: v.l2 & 4294967295u64, l3: 0u64 };
}

// Writes the 20 address bytes of a (big endian) to p.
fn address_store(p: *mut u8, a: U256) -> void {
  let t: *mut u8 = zalloc(32u64);
  u256_store_be(t, a);
  let src: *mut u8 = offset_mut(t, 12i64);
  copy_bytes(p, src, 20u64);
  mfree(t);
}

// Converts a value to u64, saturating at u64::MAX.
fn u256_sat_u64(v: U256) -> u64 {
  if u256_fits_u64(v) { return v.l0; }
  return 18446744073709551615u64;
}
