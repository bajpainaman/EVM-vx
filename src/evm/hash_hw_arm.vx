// Compresses one 64-byte block at blk into the state words a..h at st.
fn sha256_block_hw(st: *mut u32, blk: *mut u8) -> void {
  mlir!( inputs : (%st = st : !llvm.ptr, %blk = blk : !llvm.ptr), dialects : ["llvm"]) {
    %s4 = llvm.getelementptr %st[4] : (!llvm.ptr) -> !llvm.ptr, i32
    %abcd_in = llvm.load %st : !llvm.ptr -> vector<4xi32>
    %efgh_in = llvm.load %s4 : !llvm.ptr -> vector<4xi32>
    %u8 = llvm.mlir.undef : vector<16xi8>
    %mp0 = llvm.getelementptr %blk[0] : (!llvm.ptr) -> !llvm.ptr, i8
    %mb0 = llvm.load %mp0 : !llvm.ptr -> vector<16xi8>
    %mr0 = llvm.shufflevector %mb0, %u8 [3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12] : vector<16xi8>
    %m0_0 = llvm.bitcast %mr0 : vector<16xi8> to vector<4xi32>
    %mp1 = llvm.getelementptr %blk[16] : (!llvm.ptr) -> !llvm.ptr, i8
    %mb1 = llvm.load %mp1 : !llvm.ptr -> vector<16xi8>
    %mr1 = llvm.shufflevector %mb1, %u8 [3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12] : vector<16xi8>
    %m1_0 = llvm.bitcast %mr1 : vector<16xi8> to vector<4xi32>
    %mp2 = llvm.getelementptr %blk[32] : (!llvm.ptr) -> !llvm.ptr, i8
    %mb2 = llvm.load %mp2 : !llvm.ptr -> vector<16xi8>
    %mr2 = llvm.shufflevector %mb2, %u8 [3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12] : vector<16xi8>
    %m2_0 = llvm.bitcast %mr2 : vector<16xi8> to vector<4xi32>
    %mp3 = llvm.getelementptr %blk[48] : (!llvm.ptr) -> !llvm.ptr, i8
    %mb3 = llvm.load %mp3 : !llvm.ptr -> vector<16xi8>
    %mr3 = llvm.shufflevector %mb3, %u8 [3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12] : vector<16xi8>
    %m3_0 = llvm.bitcast %mr3 : vector<16xi8> to vector<4xi32>
    %k0 = llvm.mlir.constant(dense<[1116352408, 1899447441, -1245643825, -373957723]> : vector<4xi32>) : vector<4xi32>
    %wk0 = llvm.add %m0_0, %k0 : vector<4xi32>
    %su0_0 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256su0"(%m0_0, %m1_0) : (vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %su1_0 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256su1"(%su0_0, %m2_0, %m3_0) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %h0 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256h"(%abcd_in, %efgh_in, %wk0) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %h2_0 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256h2"(%efgh_in, %abcd_in, %wk0) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %k1 = llvm.mlir.constant(dense<[961987163, 1508970993, -1841331548, -1424204075]> : vector<4xi32>) : vector<4xi32>
    %wk1 = llvm.add %m1_0, %k1 : vector<4xi32>
    %su0_1 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256su0"(%m1_0, %m2_0) : (vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %su1_1 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256su1"(%su0_1, %m3_0, %su1_0) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %h1 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256h"(%h0, %h2_0, %wk1) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %h2_1 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256h2"(%h2_0, %h0, %wk1) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %k2 = llvm.mlir.constant(dense<[-670586216, 310598401, 607225278, 1426881987]> : vector<4xi32>) : vector<4xi32>
    %wk2 = llvm.add %m2_0, %k2 : vector<4xi32>
