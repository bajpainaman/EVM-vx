    %su1_2 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256su1"(%su0_2, %su1_0, %su1_1) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %h2 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256h"(%h1, %h2_1, %wk2) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %h2_2 = llvm.call_intrinsic "llvm.aarch64.crypto.sha256h2"(%h2_1, %h1, %wk2) : (vector<4xi32>, vector<4xi32>, vector<4xi32>) -> vector<4xi32>
    %k3 = llvm.mlir.constant(dense<[1925078388, -2132889090, -1680079193, -1046744716]> : vector<4xi32>) : vector<4xi32>
