// Block executor (SPEC §6): optimistic parallel execution over MvMem.
//
// Workers claim transactions with an atomic cursor and execute each one
// against the StateDb plus the multi-version store, so a transaction reads
// its predecessors' speculative writes (not just the committed snapshot).
// Commits happen strictly in transaction order: the committer validates the
// transaction's recorded read set against the store; if any read is stale it
// re-executes the transaction right there — every write below it is final at
// that point, so the re-execution is final. The coinbase fee of every
// transaction is a delta, summed once at finish.
//
// The host contributes only threads: each calls evmvx_block_worker until the
// block is done. All scheduling state lives here.
//
// v1 limits, by design: a transaction executes once speculatively (no
// mid-flight aborts, no ESTIMATE marks), and selfdestruct/created-account
// storage wipes are visible to speculation only after commit-time
// re-execution. Both are refinements, not correctness gaps: order-k
// validation plus re-execution decides every final state.

// One pointer, boxed so arrays of pointers index as struct arrays.
struct PtrBox {
  p: *mut i8,
}

const BX_READY: u64 = 0u64;
const BX_EXECUTED: u64 = 2u64;
const BX_COMMITTED: u64 = 3u64;

struct BlockExec {
  db: *mut StateDb,
  mv: *mut MvMem,
  envs: *mut VxEnv,
  n: u64,
  exec_cursor: *mut u64,
  k: *mut u64,
  commit_lock: *mut u64,
  status: *mut u64,
  incarnation: *mut u64,
  res: *mut PtrBox,
  ctxs: *mut PtrBox,
  fees: *mut U256,
  // Write-location log: per-tx segments into one shared array.
  wl: *mut u64,
  wl_n: *mut u64,
  wl_cap: u64,
  wl_lock: *mut u64,
  wl_start: *mut u64,
  wl_count: *mut u64,
  reexecs: *mut u64,
}

pub fn evmvx_block_new(db: *mut StateDb, envs: *mut VxEnv, n: u64) -> *mut BlockExec {
  let raw: *mut i8 = unsafe { vx_calloc(1u64, sizeof<BlockExec>() as u64) };
  let b: *mut BlockExec = raw;
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  bx.db = db;
  bx.mv = mv_new(db, 16u64 + 32u64 * n);
  bx.envs = envs;
  bx.n = n;
  bx.exec_cursor = limbs_alloc(1u64);
  bx.k = limbs_alloc(1u64);
  bx.commit_lock = limbs_alloc(1u64);
  bx.status = limbs_alloc(n);
  bx.incarnation = limbs_alloc(n);
  bx.fees = calloc_words(n);
  let rr: *mut i8 = unsafe { vx_calloc(n, sizeof<PtrBox>() as u64) };
  bx.res = rr;
  let cr: *mut i8 = unsafe { vx_calloc(n, sizeof<PtrBox>() as u64) };
  bx.ctxs = cr;
  // Fixed size for the same reason as the location array: readers index it
  // without a lock.
  bx.wl_cap = 4096u64 + 64u64 * n;
  bx.wl = limbs_alloc(bx.wl_cap);
  bx.wl_n = limbs_alloc(1u64);
  bx.wl_lock = limbs_alloc(1u64);
  bx.wl_start = limbs_alloc(n);
  bx.wl_count = limbs_alloc(n);
  bx.reexecs = limbs_alloc(1u64);
  return b;
}

fn bx_status_ptr(b: *mut BlockExec, i: u64) -> *mut u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  return offset_mut(bx.status, i as i64);
}

// Installs transaction i's writes (from its result) into the store and logs
// their location indices. Returns the segment (start, count) via out2.
fn bx_install(b: *mut BlockExec, i: u64, inc: u64, res: *mut VxResult, out2: *mut u64) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let r: &mut VxResult = unsafe { &mut res[0u64] };
  let accs: *mut OutAccount = r.accounts;
  let slots: *mut OutSlot = r.slots;
  // Collect locations locally first, then append one segment under the lock.
  let mut cap: u64 = 64u64;
  let mut locs: *mut u64 = limbs_alloc(cap);
  let mut nl: u64 = 0u64;
  let er: *mut i8 = unsafe { vx_calloc(1u64, sizeof<MvEntry>() as u64) };
  let ent: *mut MvEntry = er;
  let mut ai: u64 = 0u64;
  while ai < r.account_count {
    let a: &mut OutAccount = unsafe { &mut accs[ai] };
    let touched: bool = (a.flags & ACC_TOUCHED) != 0u64;
    if touched {
      let empty_code: bool = u256_eq(a.code_hash, keccak_empty()) || u256_is_zero(a.code_hash);
      let dead: bool = (a.flags & ACC_SELFDESTRUCTED) != 0u64
        || ((a.flags & ACC_CREATED) == 0u64 && a.nonce == 0u64 && u256_is_zero(a.balance) && empty_code);
      let mut fl: u64 = MV_ACCOUNT;
      if dead { fl = MV_ACCOUNT | MV_DELETED; }
      unsafe {
        ent[0u64] = MvEntry { txi: i, incarnation: inc, balance: a.balance, val: u256_zero(),
                              nonce: a.nonce, code_hash: a.code_hash,
                              code: dup_bytes(a.code, a.code_len), code_len: a.code_len, flags: fl };
      }
      let li: u64 = mv_write(bx.mv, true, a.address, u256_zero(), ent);
      if nl == cap { cap = cap * 2u64; locs = realloc_limbs(locs, cap); }
      unsafe { locs[nl] = li; }
      nl = nl + 1u64;
      let mut si: u64 = a.slot_start;
      let send: u64 = a.slot_start + a.slot_count;
      while si < send {
        let sl: &mut OutSlot = unsafe { &mut slots[si] };
        if !u256_eq(sl.original, sl.present) {
          unsafe {
            ent[0u64] = MvEntry { txi: i, incarnation: inc, balance: u256_zero(), val: sl.present,
                                  nonce: 0u64, code_hash: u256_zero(), code: null_u8(),
                                  code_len: 0u64, flags: 0u64 };
          }
          let li2: u64 = mv_write(bx.mv, false, a.address, sl.key, ent);
          if nl == cap { cap = cap * 2u64; locs = realloc_limbs(locs, cap); }
          unsafe { locs[nl] = li2; }
          nl = nl + 1u64;
        }
        si = si + 1u64;
      }
    }
    ai = ai + 1u64;
  }
  unsafe { vx_free(er); }
  // Append the segment.
  unsafe { evx_lock_ex(bx.wl_lock); }
  let np: *mut u64 = bx.wl_n;
  let mut start: u64 = unsafe { np[0u64] };
  // A full write log aborts the block, like a full location table.
  if start + nl > bx.wl_cap {
    let mm: &mut MvMem = unsafe { &mut (bx.mv)[0u64] };
    unsafe { evx_astore(mm.overflow, 1u64); }
    start = 0u64;
    nl = 0u64;
  }
  let wp: *mut u64 = bx.wl;
  let mut j: u64 = 0u64;
  while j < nl {
    unsafe { wp[start + j] = locs[j]; }
    j = j + 1u64;
  }
  if start + nl <= bx.wl_cap { unsafe { np[0u64] = start + nl; } }
  unsafe { evx_unlock_ex(bx.wl_lock); }
  let lr: *mut i8 = locs;
  unsafe { vx_free(lr); }
  unsafe { out2[0u64] = start; out2[1u64] = nl; }
}

// Runs transaction i (incarnation inc) against db + mv and installs writes.
fn bx_execute(b: *mut BlockExec, i: u64, inc: u64) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let env: *mut VxEnv = offset_mut(bx.envs, i as i64);
  let c: *mut Ctx = ctx_new_db(bx.db, env);
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  cx.mv = bx.mv;
  cx.txi = i;
  let res: *mut VxResult = transact_with(c, env);
  // Drop the previous incarnation's writes that this one did not redo.
  let seg: *mut u64 = limbs_alloc(2u64);
  bx_install(b, i, inc, res, seg);
  let old_start: u64 = unsafe { (bx.wl_start)[i] };
  let old_count: u64 = unsafe { (bx.wl_count)[i] };
  let new_start: u64 = unsafe { seg[0u64] };
  let new_count: u64 = unsafe { seg[1u64] };
  if inc > 0u64 && old_count > 0u64 {
    let wp: *mut u64 = bx.wl;
    let mut oi: u64 = 0u64;
    while oi < old_count {
      let ol: u64 = unsafe { wp[old_start + oi] };
      let mut found: bool = false;
      let mut ni: u64 = 0u64;
      while ni < new_count {
        if (unsafe { wp[new_start + ni] }) == ol { found = true; ni = new_count; } else { ni = ni + 1u64; }
      }
      if !found { mv_remove(bx.mv, ol, i); }
      oi = oi + 1u64;
    }
  }
  let sp: *mut u64 = bx.wl_start;
  let cp: *mut u64 = bx.wl_count;
  unsafe { sp[i] = new_start; cp[i] = new_count; }
  limbs_free(seg);
  // Free the previous incarnation's result; publish the new one.
  let rp: *mut PtrBox = bx.res;
  let rbox: &mut PtrBox = unsafe { &mut rp[i] };
  if !is_null_mut(rbox.p) {
    let orp: *mut VxResult = rbox.p;
    evmvx_result_free(orp);
  }
  let rr: *mut i8 = res;
  rbox.p = rr;
  let cp2: *mut PtrBox = bx.ctxs;
  let cbox: &mut PtrBox = unsafe { &mut cp2[i] };
  cbox.p = c;
  let fp: *mut U256 = bx.fees;
  let cfp: *mut U256 = cx.coinbase_fee;
  unsafe { fp[i] = cfp[0u64]; }
  let ip: *mut u64 = bx.incarnation;
  unsafe { ip[i] = inc; }
  unsafe { evx_astore(bx_status_ptr(b, i), BX_EXECUTED); }
}

// Validates transaction i's recorded reads against the store as of index i.
fn bx_validate(b: *mut BlockExec, i: u64) -> bool {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let cp: *mut PtrBox = bx.ctxs;
  let cbox: &mut PtrBox = unsafe { &mut cp[i] };
  let c: *mut Ctx = cbox.p;
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  let mut j: u64 = 0u64;
  let mut ok: bool = true;
  while j < cx.rs_n {
    let pa: *mut U256 = cx.rs_a;
    let pk: *mut U256 = cx.rs_k;
    let p1: *mut u64 = cx.rs_isacct;
    let p2: *mut u64 = cx.rs_base;
    let p3: *mut u64 = cx.rs_txi;
    let p4: *mut u64 = cx.rs_inc;
    let ra: U256 = unsafe { pa[j] };
    let rk: U256 = unsafe { pk[j] };
    let ria: bool = (unsafe { p1[j] }) != 0u64;
    let rb: bool = (unsafe { p2[j] }) != 0u64;
    let rt: u64 = unsafe { p3[j] };
    let ri: u64 = unsafe { p4[j] };
    let good: bool = mv_validate_read(bx.mv, ria, ra, rk, i, rb, rt, ri);
    if !good { ok = false; j = cx.rs_n; } else { j = j + 1u64; }
  }
  return ok;
}

// Advances the commit index while the next transaction is executed: validate,
// re-execute on a stale read (final, since the whole prefix is committed),
// then commit. One worker drains at a time.
fn bx_try_commit(b: *mut BlockExec) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  if (unsafe { evx_acas(bx.commit_lock, 0u64, 1u64) }) == 0u64 { return; }
  loop {
    let k: u64 = unsafe { evx_aload(bx.k) };
    if k >= bx.n { unsafe { evx_astore(bx.commit_lock, 0u64); } return; }
    let st: u64 = unsafe { evx_aload(bx_status_ptr(b, k)) };
    if st != BX_EXECUTED { unsafe { evx_astore(bx.commit_lock, 0u64); } return; }
    if !bx_validate(b, k) {
      let ip: *mut u64 = bx.incarnation;
      let inc: u64 = unsafe { ip[k] };
      bx_execute(b, k, inc + 1u64);
      unsafe { evx_afetch_add(bx.reexecs, 1u64); }
    }
    unsafe { evx_astore(bx_status_ptr(b, k), BX_COMMITTED); }
    unsafe { evx_astore(bx.k, k + 1u64); }
  }
}

// Worker body: host threads call this; it returns when the block is done.
pub fn evmvx_block_worker(b: *mut BlockExec) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  loop {
    if mv_overflowed(bx.mv) { return; }
    if (unsafe { evx_aload(bx.k) }) >= bx.n { return; }
    let i: u64 = unsafe { evx_afetch_add(bx.exec_cursor, 1u64) };
    if i < bx.n {
      bx_execute(b, i, 0u64);
      bx_try_commit(b);
    } else {
      bx_try_commit(b);
    }
  }
}

pub fn evmvx_block_result(b: *mut BlockExec, i: u64) -> *mut VxResult {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let rp: *mut PtrBox = bx.res;
  let rbox: &mut PtrBox = unsafe { &mut rp[i] };
  let r: *mut VxResult = rbox.p;
  return r;
}

pub fn evmvx_block_reexecs(b: *mut BlockExec) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  return unsafe { evx_aload(bx.reexecs) };
}

// Applies every committed result to the StateDb in order, pays the summed
// coinbase fees once, and returns the committed count.
pub fn evmvx_block_finish(b: *mut BlockExec) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  // An aborted block commits nothing; the host re-runs it sequentially.
  if mv_overflowed(bx.mv) { return 0u64; }
  let done: u64 = unsafe { evx_aload(bx.k) };
  let mut i: u64 = 0u64;
  let mut fee_sum: U256 = u256_zero();
  while i < done {
    let rp: *mut PtrBox = bx.res;
    let rbox: &mut PtrBox = unsafe { &mut rp[i] };
    let r: *mut VxResult = rbox.p;
    db_apply(bx.db, r);
    let fp: *mut U256 = bx.fees;
    fee_sum = u256_add(fee_sum, unsafe { fp[i] });
    i = i + 1u64;
  }
  if done > 0u64 && !u256_is_zero(fee_sum) {
    let e0: &mut VxEnv = unsafe { &mut (bx.envs)[0u64] };
    db_balance_incr(bx.db, e0.coinbase, fee_sum, e0.spec >= SPEC_SPURIOUS_DRAGON);
  }
  return done;
}
