// YOLO: private optimistic attempts, then one owner finalizes the block.
// The host exclusively owns StateDb from new through finish/free and joins
// every worker before finalization or destruction. No execution lock exists.
// Workers only share immutable state and atomic work/completion counters.
// Input order is a valid topological repair order even for dynamic EVM keys.

struct PtrBox {
  p: *mut i8,
}

struct BlockAttempt {
  result: *mut VxResult,
  read_a: *mut U256,
  read_k: *mut U256,
  read_kind: *mut u64,
  read_n: u64,
  cb_read: u64,
}

struct BlockConflict {
  address: U256,
  key: U256,
  // 0: none; 1: account; 2: storage; 3: deferred fee recipient.
  kind: u64,
  expected: u64,
  observed: u64,
  // 1: account value; 2: storage value; 4: lifecycle; 8: fees.
  reason: u64,
}

struct BlockExec {
  db: *mut StateDb,
  base: *mut MvMem,
  mv: *mut MvMem,
  tabs: *mut OpTabs,
  envs: *mut VxEnv,
  n: u64,
  cursor: *mut u64,
  ready: *mut u64,
  aborted: *mut u64,
  attempts: *mut BlockAttempt,
  conflicts: *mut BlockConflict,
  fees: *mut U256,
  pending_fees: *mut U256,
  fold_from: u64,
  reexecs: u64,
  cb_txs: u64,
  // 0: collecting; 1: published; 2: abandoned. Host-owned after join.
  finished: u64,
}

pub fn evmvx_block_new(db: *mut StateDb, envs: *mut VxEnv, n: u64) -> *mut BlockExec {
  let raw: *mut i8 = unsafe { vx_calloc(1u64, sizeof<BlockExec>() as u64) };
  let b: *mut BlockExec = raw;
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  bx.db = db;
  bx.base = mv_new(db, 16u64);
  bx.mv = mv_new(db, 16u64);
  bx.envs = envs;
  bx.n = n;
  let mut spec: u64 = SPEC_CANCUN;
  if n > 0u64 {
    let e: &mut VxEnv = unsafe { &mut envs[0u64] };
    spec = e.spec;
  }
  bx.tabs = tabs_new(spec);
  bx.cursor = limbs_alloc(1u64);
  bx.ready = limbs_alloc(n);
  bx.aborted = limbs_alloc(1u64);
  bx.fees = calloc_words(n);
  bx.pending_fees = calloc_words(1u64);
  let ar: *mut i8 = unsafe { vx_calloc(n, sizeof<BlockAttempt>() as u64) };
  bx.attempts = ar;
  let cr: *mut i8 = unsafe { vx_calloc(n, sizeof<BlockConflict>() as u64) };
  bx.conflicts = cr;
  return b;
}

fn bx_result(b: *mut BlockExec, i: u64) -> *mut VxResult {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let a: &mut BlockAttempt = unsafe { &mut (bx.attempts)[i] };
  return a.result;
}

// Each claimed transaction owns its result and read log. No shared arena
// reservation, installation, validation, or retry happens on a worker.
fn bx_execute(b: *mut BlockExec, c: *mut Ctx, i: u64, repair: bool) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let env: *mut VxEnv = offset_mut(bx.envs, i as i64);
  ctx_reset(c, env);
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  cx.mv = bx.base;
  cx.rs_on = 1u64;
  if repair {
    cx.mv = bx.mv;
    cx.rs_on = 0u64;
    // A repair may discover a coinbase read that speculation never took.
    bx_coinbase_exact(b, i, c);
    cx.cb_ov_on = 1u64;
  }
  cx.txi = i;
  cx.tabs_shared = bx.tabs;
  let result: *mut VxResult = transact_with(c, env);
  let a: &mut BlockAttempt = unsafe { &mut (bx.attempts)[i] };
  if !is_null_mut(a.result) {
    evmvx_result_free(a.result);
  }
  a.result = result;
  a.cb_read = cx.cb_read;
  unsafe { (bx.fees)[i] = (cx.coinbase_fee)[0u64]; }
  if !repair {
    a.read_n = cx.rs_n;
    a.read_a = calloc_words(cx.rs_n);
    a.read_k = calloc_words(cx.rs_n);
    a.read_kind = limbs_alloc(cx.rs_n);
    let mut j: u64 = 0u64;
    while j < cx.rs_n {
      unsafe {
        (a.read_a)[j] = (cx.rs_a)[j];
        (a.read_k)[j] = (cx.rs_k)[j];
        (a.read_kind)[j] = (cx.rs_isacct)[j];
      }
      j = j + 1u64;
    }
  }
}

pub fn evmvx_block_worker(b: *mut BlockExec) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  if bx.n == 0u64 {
    return;
  }
  let c: *mut Ctx = ctx_new_db(bx.db, bx.envs);
  loop {
    if (unsafe { evx_aload(bx.aborted) }) != 0u64 {
      break;
    }
    let i: u64 = unsafe { evx_afetch_add(bx.cursor, 1u64) };
    if i >= bx.n {
      break;
    }
    bx_execute(b, c, i, false);
    unsafe { evx_astore(offset_mut(bx.ready, i as i64), 1u64); }
  }
  ctx_free(c);
}

// Every optimistic read saw the base. A final earlier semantic write makes
// that attempt stale. Only the finalizer accesses the prefix maps.
fn bx_validate(b: *mut BlockExec, i: u64, tmp: *mut MvEntry) -> bool {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let a: &mut BlockAttempt = unsafe { &mut (bx.attempts)[i] };
  if a.cb_read != 0u64 {
    unsafe { (bx.conflicts)[i] = BlockConflict { address: bx_coinbase(b), key: u256_zero(),
        kind: 3u64, expected: MAP_NONE, observed: i, reason: 8u64 }; }
    return false;
  }
  let mut j: u64 = 0u64;
  while j < a.read_n {
    let addr: U256 = unsafe { (a.read_a)[j] };
    let key: U256 = unsafe { (a.read_k)[j] };
    let acct: bool = (unsafe { (a.read_kind)[j] }) != 0u64;
    if mv_read(bx.mv, acct, addr, key, i, tmp) == MVR_HIT {
      let e: &mut MvEntry = unsafe { &mut tmp[0u64] };
      let mut kind: u64 = 2u64;
      let mut reason: u64 = 2u64;
      if acct {
        kind = 1u64; reason = 1u64;
      }
      if (e.flags & MV_RESET) != 0u64 {
        reason = 4u64;
      }
      unsafe { (bx.conflicts)[i] = BlockConflict { address: addr, key: key,
          kind: kind, expected: MAP_NONE, observed: e.txi, reason: reason }; }
      return false;
    }
    j = j + 1u64;
  }
  return true;
}

// This comparison is safe only AFTER validation/repair against the final
// prefix. Touch bookkeeping remains in the result; it is not a value write.
fn bx_account_changed(b: *mut BlockExec, i: u64, a: *mut OutAccount, tmp: *mut MvEntry, ha: *mut HostAccount) -> bool {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let oa: &mut OutAccount = unsafe { &mut a[0u64] };
  let mut exists: bool = false;
  if mv_read(bx.mv, true, oa.address, u256_zero(), i, tmp) == MVR_HIT {
    let e: &mut MvEntry = unsafe { &mut tmp[0u64] };
    exists = (e.flags & MV_DELETED) == 0u64;
    unsafe { ha[0u64] = HostAccount { balance: e.balance, nonce: e.nonce,
        code_hash: e.code_hash, code: e.code, code_len: e.code_len }; }
  } else {
    exists = db_account(bx.db, oa.address, ha) == HOST_OK;
  }
  if !exists {
    return true;
  }
  let h: &mut HostAccount = unsafe { &mut ha[0u64] };
  return !u256_eq(h.balance, oa.balance) || h.nonce != oa.nonce || !u256_eq(h.code_hash, oa.code_hash) || h.code_len != oa.code_len;
}

fn bx_install(b: *mut BlockExec, c: *mut Ctx, i: u64) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  let r: *mut VxResult = bx_result(b, i);
  let rr: &mut VxResult = unsafe { &mut r[0u64] };
  let ent: *mut MvEntry = cx.mv_scratch;
  let mut ai: u64 = 0u64;
  while ai < rr.account_count {
    let ap: *mut OutAccount = offset_mut(rr.accounts, ai as i64);
    let a: &mut OutAccount = unsafe { &mut ap[0u64] };
    if (a.flags & ACC_TOUCHED) != 0u64 {
      let empty_code: bool = u256_eq(a.code_hash, keccak_empty()) || u256_is_zero(a.code_hash);
      let dead: bool = (a.flags & ACC_SELFDESTRUCTED) != 0u64 || ((a.flags & ACC_CREATED) == 0u64 && a.nonce == 0u64 && u256_is_zero(a.balance) && empty_code);
      let reset: bool = dead || (a.flags & ACC_CREATED) != 0u64;
      if reset || bx_account_changed(b, i, ap, ent, cx.hacc) {
        let mut flags: u64 = MV_ACCOUNT;
        if dead {
          flags = flags | MV_DELETED;
        }
        if reset {
          flags = flags | MV_RESET;
        }
        unsafe { ent[0u64] = MvEntry { txi: i, incarnation: 0u64,
            balance: a.balance, val: u256_zero(), nonce: a.nonce, code_hash: a.code_hash,
            code: a.code, code_len: a.code_len, flags: flags }; }
        mv_write(bx.mv, true, a.address, u256_zero(), ent);
      }
      if !dead {
        let mut si: u64 = a.slot_start;
        while si < a.slot_start + a.slot_count {
          let sl: &mut OutSlot = unsafe { &mut (rr.slots)[si] };
          if !u256_eq(sl.original, sl.present) {
            unsafe { ent[0u64] = MvEntry { txi: i, incarnation: 0u64,
                balance: u256_zero(), val: sl.present, nonce: 0u64, code_hash: u256_zero(),
                code: null_u8(), code_len: 0u64, flags: 0u64 }; }
            mv_write(bx.mv, false, a.address, sl.key, ent);
          }
          si = si + 1u64;
        }
      }
    }
    ai = ai + 1u64;
  }
}

fn bx_coinbase(b: *mut BlockExec) -> U256 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let e0: &mut VxEnv = unsafe { &mut (bx.envs)[0u64] };
  return e0.coinbase;
}

// Fills the committer Ctx's coinbase override for tx k: the latest committed
// explicit coinbase state (a versioned write below k, or the StateDb) plus
// every fee not yet folded into a coinbase write (txs fold_from .. k-1).
fn bx_coinbase_exact(b: *mut BlockExec, k: u64, c: *mut Ctx) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  let cb: U256 = bx_coinbase(b);
  let ov: *mut HostAccount = cx.cb_ov;
  let r: u64 = mv_read(bx.mv, true, cb, u256_zero(), k, cx.mv_scratch);
  let mut exists: bool = false;
  if r == MVR_HIT {
    let e: &mut MvEntry = unsafe { &mut (cx.mv_scratch)[0u64] };
    unsafe { ov[0u64] = HostAccount { balance: e.balance, nonce: e.nonce, code_hash: e.code_hash,
        code: e.code, code_len: e.code_len }; }
    exists = (e.flags & MV_DELETED) == 0u64;
  } else {
    exists = db_account(bx.db, cb, ov) == HOST_OK;
  }
  let fees: U256 = unsafe { (bx.pending_fees)[0u64] };
  let e0: &mut VxEnv = unsafe { &mut (bx.envs)[0u64] };
  let eip161: bool = e0.spec >= SPEC_SPURIOUS_DRAGON;
  if !exists {
    unsafe { ov[0u64] = HostAccount { balance: u256_zero(), nonce: 0u64, code_hash: keccak_empty(),
        code: null_u8(), code_len: 0u64 }; }
    // Fee payments (or, before Spurious Dragon, their touch) create it.
    if k > bx.fold_from && (!eip161 || !u256_is_zero(fees)) {
      exists = true;
    }
  }
  let cur: HostAccount = unsafe { ov[0u64] };
  unsafe { ov[0u64] = HostAccount { balance: u256_add(cur.balance, fees), nonce: cur.nonce,
      code_hash: cur.code_hash, code: cur.code, code_len: cur.code_len }; }
  cx.cb_ov_exists = 0u64;
  if exists {
    cx.cb_ov_exists = 1u64;
  }
}

// Whether tx k's result writes account a (it is in the result, touched).
fn bx_result_writes(b: *mut BlockExec, k: u64, a: U256) -> bool {
  let r: *mut VxResult = bx_result(b, k);
  let rr: &mut VxResult = unsafe { &mut r[0u64] };
  let accs: *mut OutAccount = rr.accounts;
  let mut i: u64 = 0u64;
  while i < rr.account_count {
    let oa: &mut OutAccount = unsafe { &mut accs[i] };
    if u256_eq(oa.address, a) && (oa.flags & ACC_TOUCHED) != 0u64 {
      return true;
    }
    i = i + 1u64;
  }
  return false;
}


// The caller must join every worker first. Validate the entire block before
// publishing anything. Repeated finish is idempotent; incomplete work aborts.
pub fn evmvx_block_finish(b: *mut BlockExec) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  if bx.finished == 1u64 {
    return bx.n;
  }
  if bx.finished == 2u64 || (unsafe { evx_aload(bx.aborted) }) != 0u64 {
    return 0u64;
  }
  let mut i: u64 = 0u64;
  while i < bx.n {
    if (unsafe { evx_aload(offset_mut(bx.ready, i as i64)) }) == 0u64 {
      evmvx_block_cancel(b);
      bx.finished = 2u64;
      return 0u64;
    }
    i = i + 1u64;
  }
  if bx.n == 0u64 {
    bx.finished = 1u64; return 0u64;
  }
  let c: *mut Ctx = ctx_new_db(bx.db, bx.envs);
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  i = 0u64;
  while i < bx.n {
    if !bx_validate(b, i, cx.mv_scratch) {
      bx_execute(b, c, i, true);
      bx.reexecs = bx.reexecs + 1u64;
      let a: &mut BlockAttempt = unsafe { &mut (bx.attempts)[i] };
      if a.cb_read != 0u64 {
        bx.cb_txs = bx.cb_txs + 1u64;
      }
    }
    let result: *mut VxResult = bx_result(b, i);
    let r: &mut VxResult = unsafe { &mut result[0u64] };
    if r.status == RES_HOST_FAILURE || r.status == RES_INVALID_TX {
      evmvx_block_cancel(b);
      bx.finished = 2u64;
      ctx_free(c);
      return 0u64;
    }
    bx_install(b, c, i);
    if bx_result_writes(b, i, bx_coinbase(b)) {
      bx.fold_from = i;
      unsafe { (bx.pending_fees)[0u64] = u256_zero(); }
    }
    unsafe {
      (bx.pending_fees)[0u64] = u256_add((bx.pending_fees)[0u64], (bx.fees)[i]);
    }
    i = i + 1u64;
  }
  ctx_free(c);
  // All attempt data stays alive until publication and block_free.
  i = 0u64;
  while i < bx.n {
    db_apply(bx.db, bx_result(b, i));
    i = i + 1u64;
  }
  let e: &mut VxEnv = unsafe { &mut (bx.envs)[0u64] };
  db_balance_incr(bx.db, e.coinbase, unsafe { (bx.pending_fees)[0u64] }, e.spec >= SPEC_SPURIOUS_DRAGON);
  bx.finished = 1u64;
  return bx.n;
}

pub fn evmvx_block_cancel(b: *mut BlockExec) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  unsafe { evx_astore(bx.aborted, 1u64); }
}

pub fn evmvx_block_result(b: *mut BlockExec, i: u64) -> *mut VxResult {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  if i >= bx.n || bx.finished != 1u64 {
    let p: *mut i8 = null_i8();
    let r: *mut VxResult = p;
    return r;
  }
  return bx_result(b, i);
}

pub fn evmvx_block_reexecs(b: *mut BlockExec) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  return bx.reexecs;
}
pub fn evmvx_block_coinbase_txs(b: *mut BlockExec) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  return bx.cb_txs;
}
pub fn evmvx_block_aborted(b: *mut BlockExec) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  return unsafe { evx_aload(bx.aborted) };
}
pub fn evmvx_block_fee(b: *mut BlockExec, i: u64, out: *mut U256) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  unsafe { out[0u64] = u256_zero(); }
  if i < bx.n && bx.finished == 1u64 {
    unsafe { out[0u64] = (bx.fees)[i]; }
  }
}
pub fn evmvx_block_tail_fees(b: *mut BlockExec, out: *mut U256) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  unsafe { out[0u64] = (bx.pending_fees)[0u64]; }
}
// Available after finish; expected MAP_NONE denotes the immutable base.
pub fn evmvx_block_conflict(b: *mut BlockExec, i: u64, out: *mut BlockConflict) -> u64 {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  if i >= bx.n || bx.finished != 1u64 {
    return 0u64;
  }
  unsafe { out[0u64] = (bx.conflicts)[i]; }
  return 1u64;
}

// Join workers before calling this, including on cancellation or host failure.
pub fn evmvx_block_free(b: *mut BlockExec) -> void {
  let bx: &mut BlockExec = unsafe { &mut b[0u64] };
  let mut i: u64 = 0u64;
  while i < bx.n {
    let a: &mut BlockAttempt = unsafe { &mut (bx.attempts)[i] };
    if !is_null_mut(a.result) {
      evmvx_result_free(a.result);
    }
    free_words(a.read_a);
    free_words(a.read_k);
    limbs_free(a.read_kind);
    i = i + 1u64;
  }
  mv_free(bx.base);
  mv_free(bx.mv);
  tabs_free(bx.tabs);
  limbs_free(bx.cursor);
  limbs_free(bx.ready);
  limbs_free(bx.aborted);
  free_words(bx.fees);
  free_words(bx.pending_fees);
  let a: *mut i8 = bx.attempts;
  let cf: *mut i8 = bx.conflicts;
  let raw: *mut i8 = b;
  unsafe { vx_free(a); vx_free(cf); vx_free(raw); }
}
