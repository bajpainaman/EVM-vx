// The interpreter loop: fetch, charge static gas, check the stack, dispatch.

// Runs `root` and every frame it calls on an explicit frame stack, so the
// native stack depth stays constant whatever the call depth. A CALL/CREATE
// suspends its frame (R_SUSPEND) with the child linked from it; when a child
// ends, its parent resumes from the saved continuation. Returns root's result.
fn run_frame(c: *mut Ctx, root: *mut Frame) -> u64 {
  let traw: *mut i8 = unsafe { vx_calloc(2u64, 8u64) };
  let tmp: *mut u64 = traw;
  let sraw: *mut i8 = unsafe { vx_calloc(1u64, sizeof<SdResult>() as u64) };
  let sd: *mut SdResult = sraw;
  let root_depth: u64 = frame_depth(root);
  let mut cur: *mut Frame = root;
  let mut res: u64 = R_STOP;
  let mut unwinding: bool = false;
  loop {
    if unwinding { res = R_FATAL; } else { res = run_loop(c, cur, tmp, sd); }
    if res == R_SUSPEND {
      let fr: &mut Frame = unsafe { &mut cur[0u64] };
      let child: *mut Frame = fr.k_child;
      let cr: &mut Frame = unsafe { &mut child[0u64] };
      cr.parent = cur;
      cur = child;
    } else {
      if frame_depth(cur) == root_depth { break; }
      let cf: &mut Frame = unsafe { &mut cur[0u64] };
      let parent: *mut Frame = cf.parent;
      resume_parent(c, parent, cur, res);
      cur = parent;
      if is_fatal(c) { unwinding = true; }
    }
  }
  unsafe { vx_free(traw); vx_free(sraw); }
  return res;
}

// The interpreter loop. Hot state (pc, gas, stack pointer, code, stack base
// and the opcode tables) lives in locals so it stays in registers, the way
// evm2's packed dispatch keeps it. Stack, push, jump and pure arithmetic
// opcodes run inline on the stack slots; every other opcode writes the
// locals back to the frame, runs its handler, and reloads them.
fn run_loop(c: *mut Ctx, f: *mut Frame, tmp: *mut u64, sd: *mut SdResult) -> u64 {
  let spec: u64 = ctx_spec(c);
  let fr0: &mut Frame = unsafe { &mut f[0u64] };
  let code: *mut u8 = fr0.code;
  let code_len: u64 = fr0.code_len;
  let st: *mut U256 = fr0.stack;
  let jd: *mut u8 = fr0.jd;
  let tp: *mut OpTabs = fr0.tabs;
  let t: &mut OpTabs = unsafe { &mut tp[0u64] };
  let actp: *mut u8 = t.act;
  let gp: *mut u64 = t.gas;
  let sip: *mut u8 = t.sin;
  let sop: *mut u8 = t.sout;
  let mut pc: u64 = fr0.pc;
  let mut gas: u64 = fr0.gas;
  let mut sp: u64 = fr0.sp;
  let mut res: u64 = R_STOP;
  loop {
    if pc >= code_len { res = R_STOP; break; }
    let op: u64 = (unsafe { code[pc] }) as u64;
    pc = pc + 1u64;
    let a: u8 = unsafe { actp[op] };
    if a == 0u8 { res = R_OPCODE_NOT_FOUND; break; }
    if a == 2u8 { res = R_NOT_ACTIVATED; break; }
    let g: u64 = unsafe { gp[op] };
    if g > gas { res = R_OOG; break; }
    gas = gas - g;
    let si: u64 = (unsafe { sip[op] }) as u64;
    let so: u64 = (unsafe { sop[op] }) as u64;
    if sp < si { res = R_STACK_UNDERFLOW; break; }
    if sp - si + so > STACK_LIMIT { res = R_STACK_OVERFLOW; break; }
    let mut hot: bool = true;
    let mut done: bool = false;
    if op >= 96u64 && op <= 127u64 {
      let n: u64 = op - 95u64;
      unsafe { st[sp] = u256_load_be_n(code, code_len, pc, n); }
      pc = pc + n;
      sp = sp + 1u64;
    } else if op >= 128u64 && op <= 143u64 {
      let n: u64 = op - 127u64;
      unsafe { st[sp] = st[sp - n]; }
      sp = sp + 1u64;
    } else if op >= 144u64 && op <= 159u64 {
      let n: u64 = op - 143u64;
      let top: u64 = sp - 1u64;
      let x: U256 = unsafe { st[top] };
      let y: U256 = unsafe { st[top - n] };
      unsafe { st[top] = y; st[top - n] = x; }
    } else {
      let o: i32 = op as i32;
      match o {
        0 => { res = R_STOP; done = true; }
        1 => { unsafe { st[sp - 2u64] = u256_add(st[sp - 1u64], st[sp - 2u64]); } sp = sp - 1u64; }
        3 => { unsafe { st[sp - 2u64] = u256_sub(st[sp - 1u64], st[sp - 2u64]); } sp = sp - 1u64; }
        16 => { unsafe { st[sp - 2u64] = u256_from_bool(u256_lt(st[sp - 1u64], st[sp - 2u64])); } sp = sp - 1u64; }
        17 => { unsafe { st[sp - 2u64] = u256_from_bool(u256_gt(st[sp - 1u64], st[sp - 2u64])); } sp = sp - 1u64; }
        20 => { unsafe { st[sp - 2u64] = u256_from_bool(u256_eq(st[sp - 1u64], st[sp - 2u64])); } sp = sp - 1u64; }
        21 => { unsafe { st[sp - 1u64] = u256_from_bool(u256_is_zero(st[sp - 1u64])); } }
        22 => { unsafe { st[sp - 2u64] = u256_and(st[sp - 1u64], st[sp - 2u64]); } sp = sp - 1u64; }
        23 => { unsafe { st[sp - 2u64] = u256_or(st[sp - 1u64], st[sp - 2u64]); } sp = sp - 1u64; }
        24 => { unsafe { st[sp - 2u64] = u256_xor(st[sp - 1u64], st[sp - 2u64]); } sp = sp - 1u64; }
        80 => { sp = sp - 1u64; }
        86 => {
          let dest: U256 = unsafe { st[sp - 1u64] };
          sp = sp - 1u64;
          if is_jumpdest(jd, code_len, dest) { pc = dest.l0; } else { res = R_INVALID_JUMP; done = true; }
        }
        87 => {
          let dest: U256 = unsafe { st[sp - 1u64] };
          let cond: U256 = unsafe { st[sp - 2u64] };
          sp = sp - 2u64;
          if !u256_is_zero(cond) {
            if is_jumpdest(jd, code_len, dest) { pc = dest.l0; } else { res = R_INVALID_JUMP; done = true; }
          }
        }
        91 => { }
        95 => { unsafe { st[sp] = u256_zero(); } sp = sp + 1u64; }
        _ => { hot = false; }
      }
    }
    if done { break; }
    if !hot {
      let fw: &mut Frame = unsafe { &mut f[0u64] };
      fw.pc = pc;
      fw.gas = gas;
      fw.sp = sp;
      let r: u64 = dispatch(c, f, op, spec, tmp, sd);
      let fl: &mut Frame = unsafe { &mut f[0u64] };
      pc = fl.pc;
      gas = fl.gas;
      sp = fl.sp;
      if r != R_CONTINUE { res = r; break; }
      if is_fatal(c) { res = R_FATAL; break; }
    }
  }
  let fe: &mut Frame = unsafe { &mut f[0u64] };
  fe.pc = pc;
  fe.gas = gas;
  fe.sp = sp;
  return res;
}

fn ctx_spec(c: *mut Ctx) -> u64 {
  let cx: &mut Ctx = unsafe { &mut c[0u64] };
  return cx.spec;
}

fn dispatch(c: *mut Ctx, f: *mut Frame, op: u64, spec: u64, tmp: *mut u64, sd: *mut SdResult) -> u64 {
  if op >= 95u64 && op <= 127u64 { return op_push(f, op - 95u64); }
  if op >= 128u64 && op <= 143u64 { return op_dup(f, op - 127u64); }
  if op >= 144u64 && op <= 159u64 { return op_swap(f, op - 143u64); }
  if op >= 160u64 && op <= 164u64 { return op_log(c, f, op - 160u64); }
  let o: i32 = op as i32;
  match o {
    0 => { return R_STOP; }
    8 => { return op_ternary_mod(f, op); }
    9 => { return op_ternary_mod(f, op); }
    10 => { return op_exp(f, spec); }
    21 => { return op_unary(f, op); }
    25 => { return op_unary(f, op); }
    30 => { return op_unary(f, op); }
    32 => { return op_keccak(f); }
    49 => { return op_balance(c, f); }
    53 => { return op_calldataload(f); }
    55 => { return op_copy(f, 0u64, tmp); }
    57 => { return op_copy(f, 1u64, tmp); }
    59 => { return op_extcodesize(c, f); }
    60 => { return op_extcodecopy(c, f, tmp); }
    62 => { return op_copy(f, 2u64, tmp); }
    63 => { return op_extcodehash(c, f); }
    64 => { return op_blockhash(c, f); }
    71 => { return op_selfbalance(c, f); }
    73 => { return op_blobhash(c, f); }
    80 => { let _v: U256 = stack_pop(f); return R_CONTINUE; }
    81 => { return op_mload(f); }
    82 => { return op_mstore(f, false); }
    83 => { return op_mstore(f, true); }
    84 => { return op_sload(c, f); }
    85 => { return op_sstore(c, f); }
    86 => { return op_jump(f, false); }
    87 => { return op_jump(f, true); }
    91 => { return R_CONTINUE; }
    92 => { return op_tload(c, f); }
    93 => { return op_tstore(c, f); }
    94 => { return op_mcopy(f); }
    240 => { return op_create(c, f, false); }
    241 => { return op_call(c, f, op); }
    242 => { return op_call(c, f, op); }
    243 => { return op_return(f, R_RETURN); }
    244 => { return op_call(c, f, op); }
    245 => { return op_create(c, f, true); }
    250 => { return op_call(c, f, op); }
    253 => { return op_return(f, R_REVERT); }
    254 => { return R_INVALID_FE; }
    255 => { return op_selfdestruct(c, f, sd); }
    _ => {}
  }
  if (op >= 1u64 && op <= 29u64) { return op_binary(f, op); }
  return op_env_push(c, f, op);
}
